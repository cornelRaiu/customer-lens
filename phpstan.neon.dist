parameters:
	level: 5
	phpVersion:
		min: 80100
		max: 80599
	paths:
		- customer-lens.php
		- uninstall.php
		- src
		- templates
	scanFiles:
		- vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
		- vendor/php-stubs/woocommerce-stubs/woocommerce-packages-stubs.php
		- tests/phpstan/wp-cli.php
	scanDirectories:
		- vendor-prefixed
	# The WooCommerce stubs define WC_VERSION as '0.0.0'.
	dynamicConstantNames:
		- WC_VERSION
	ignoreErrors:
		# The requirements check exists for sites running PHP below the supported minimum.
		-
			identifier: booleanOr.leftAlwaysFalse
			path: customer-lens.php
