#. Plugin Name of the plugin
#: customer-lens.php
msgid "Customer Lens – Customer History & Risk Signals for WooCommerce"
msgstr "Customer Lens – Customer History & Risk Signals for WooCommerce"

#. Plugin URI of the plugin
#: customer-lens.php
msgid "https://customerlens.app/"
msgstr "https://customerlens.app/"

#. Description of the plugin
#: customer-lens.php
msgid "Shows each customer's previous orders and risk signals on the WooCommerce order screen: refunds, cancellations, failed payments and refused deliveries, matched by email, phone and address."
msgstr "Arată comenzile anterioare ale fiecărui client și semnalele de risc pe ecranul comenzii WooCommerce: rambursări, anulări, plăți eșuate și colete refuzate, regăsite după e-mail, telefon și adresă."

#. Author of the plugin
#: customer-lens.php
msgid "Cornel Raiu"
msgstr "Cornel Raiu"

#. Author URI of the plugin
#: customer-lens.php
msgid "https://www.cornelraiu.com/"
msgstr "https://www.cornelraiu.com/"

#: customer-lens.php:44
msgid "Customer Lens needs PHP 8.1 or later and WordPress 6.4 or later, so it is not running. Update PHP or WordPress to use it."
msgstr "Customer Lens are nevoie de PHP 8.1 sau mai nou și WordPress 6.4 sau mai nou, așa că nu rulează. Actualizați PHP sau WordPress ca să îl folosiți."

#: customer-lens.php:45
msgid "Customer Lens is missing its vendor folders, so it is not running. Run composer install, or reinstall the plugin from WordPress.org."
msgstr "Lui Customer Lens îi lipsesc folderele vendor, așa că nu rulează. Rulați composer install sau reinstalați modulul de pe WordPress.org."

